@page
@model Academy.Areas.Admin.Pages.Departments.IndexModel
@{  
}

<div class="row">
    <div class="col-xxl-12 col-xl-12">
        <div class="card card-height-100">
           @*  <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">@sharedResource["Orders"]</h4>
                <div class="flex-shrink-0">
                    <a href="/admin/Configurations/ManageCreateOrder/CreateOrder" class="btn btn-soft-primary">
                        @sharedResource["Create Order"]
                    </a>
                </div>
            </div> *@
            <!-- end card header -->
            <!-- card body -->
            <div class="card-body">

                @(Html.DevExtreme().DataGrid<Academy.Models.Department>()
                    .DataSource(ds => ds.Mvc().Controller("Home").LoadAction("GetDepartments").Key("DepartmentId"))
                    .RemoteOperations(true).ColumnHidingEnabled(true).Width("100%")
                    .Columns(columns =>
                    {
                        columns.AddFor(m => m.DepartmentId).SortOrder(SortOrder.Desc).Caption("DepartmentId").HidingPriority(42);
                        columns.AddFor(m => m.DepartmentNameAR).Caption("Department Name").HidingPriority(40);
                        columns.Add().HidingPriority(38).Caption("Actions").Alignment(HorizontalAlignment.Center).CellTemplate(@<text>
                    <div class="btn-group" role="group" aria-label="Basic example" style="justify-content:space-between!important;width:90%;font-size:40px">
                        <a onclick="onViewClick('<%- data.OrderId %>')"
                           class="text-primary d-inline-block">
                            <i class="ri-eye-fill fs-30"></i>
                        </a>


                        <a href="/Admin/Configurations/ManageOrder/EditOrder?Id=<%- data.OrderId %>"
                           target="_blank" class="text-primary d-inline-block">
                            <i class="ri-pencil-fill fs-30"></i>
                        </a>
                    </div>
                </text>);
                      
                    })
                    .ShowColumnLines(true)
                    .ShowRowLines(true)
                    .Export(e => e.Enabled(true).AllowExportSelectedData(true))
                    .OnExporting("exporting")
                    /* .RowAlternationEnabled(true) */

                    .FilterRow(f => f.Visible(true))
                    .HeaderFilter(f => f.Visible(true))
                    .GroupPanel(p => p.Visible(true))
                    /*  .Scrolling(scrolling => scrolling.RowRenderingMode(GridRowRenderingMode)) */
                    .Selection(s => s.Mode(SelectionMode.Multiple))
                    .Paging(paging => paging.PageSize(5).Enabled(true))

                    .WordWrapEnabled(true)
                    .ColumnAutoWidth(true)
                    .Width("100%")



                    .ShowBorders(true)
                    .ColumnChooser(c => c.Enabled(true))
                    .ColumnFixing(c => c.Enabled(true))
                    .ShowBorders(true)
                    .Grouping(g => g.AutoExpandAll(false))
                    .Pager(pager =>
                    {
                        pager.Visible(true);
                        pager.DisplayMode(GridPagerDisplayMode.Full);
                        pager.ShowPageSizeSelector(true);
                        pager.AllowedPageSizes(new JS("[5,10,20,50,100,'all']"));
                        pager.ShowInfo(true);
                        pager.ShowNavigationButtons(true);
                    })
                    .SearchPanel(searchPanel => searchPanel
                    .Visible(true)
                    .Placeholder("SearchTxt"))
                    .RemoteOperations(false)
                    )
            </div>
            <!-- end card body -->
        </div><!-- end card -->
    </div>
</div>

                        <script>
    function exporting(e) {
        var workbook = new ExcelJS.Workbook();
        var worksheet = workbook.addWorksheet('Orders');

        DevExpress.excelExporter.exportDataGrid({
            component: e.component,
            worksheet: worksheet,
            autoFilterEnabled: true
        }).then(function () {
            workbook.xlsx.writeBuffer().then(function (buffer) {
                var currentdate = new Date();
                var datetime = currentdate.getDate() + "_"
                    + (currentdate.getMonth() + 1) + "_"
                    + currentdate.getFullYear() + "_"
                    + currentdate.getHours() + "_"
                    + currentdate.getMinutes() + "_"
                    + currentdate.getSeconds();
                saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'Departments_' + datetime + '.xlsx');
            });
        });
        e.cancel = true;
    }
                        </script>